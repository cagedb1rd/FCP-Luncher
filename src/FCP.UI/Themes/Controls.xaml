<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 显式合并依赖的字典：模板中的 StaticResource 只能可靠地解析到本字典及其合并字典中的资源 -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/FCP.UI;component/Themes/Tokens.Light.xaml" />
    <ResourceDictionary Source="pack://application:,,,/FCP.UI;component/Themes/Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- 按下时轻微缩放（0.97），松开时回弹 -->
  <Storyboard x:Key="Anim.PressDown">
    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.08" />
    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.08" />
  </Storyboard>
  <Storyboard x:Key="Anim.PressUp">
    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.18">
      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
    </DoubleAnimation>
    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.18">
      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
    </DoubleAnimation>
  </Storyboard>

  <!-- 图标 -->
  <Style x:Key="Fcp.Icon" TargetType="Path">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    <Setter Property="SnapsToDevicePixels" Value="False" />
  </Style>

  <!-- 文字 -->
  <Style x:Key="Fcp.Text.CardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
  </Style>
  <Style x:Key="Fcp.Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
  </Style>
  <Style x:Key="Fcp.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Fcp.Text.Caption}">
    <Setter Property="Margin" Value="14,16,8,6" />
  </Style>

  <!-- 卡片 -->
  <Style x:Key="Fcp.Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Card}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Effect" Value="{StaticResource Shadow.Card}" />
  </Style>

  <!-- 标题栏窗口按钮（最小化 / 关闭 / 返回） -->
  <Style x:Key="Fcp.WindowButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnBrand}" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="16">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.OnBrandHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.OnBrandPressed}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 标题栏主标签：图标 + 文字，选中时变成白色胶囊 -->
  <Style x:Key="Fcp.TabButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnBrand}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Padding" Value="12,0,14,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Radius.Pill}" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path x:Name="IconPath" Data="{TemplateBinding Tag}" Style="{StaticResource Fcp.Icon}" Width="14" Height="14" Margin="0,0,7,0" Fill="{TemplateBinding Foreground}" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.OnBrandHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.OnBrand}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Anim.PressDown}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Anim.PressUp}" /></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 启动游戏大按钮：Content = 主文字，Tag = 副标题（版本名） -->
  <Style x:Key="Fcp.LaunchButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnBrand}" />
    <Setter Property="Background" Value="{StaticResource Brush.Brand}" />
    <Setter Property="Height" Value="58" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Card}" Effect="{StaticResource Shadow.Card}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <ContentPresenter HorizontalAlignment="Center" TextElement.FontSize="{StaticResource FontSize.Hero}" />
              <TextBlock Text="{TemplateBinding Tag}" HorizontalAlignment="Center" FontSize="{StaticResource FontSize.Caption}" Opacity="0.85" Margin="12,2,12,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandPressed}" />
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Anim.PressDown}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Anim.PressUp}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 次级按钮：白底、品牌色文字 -->
  <Style x:Key="Fcp.Button" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
    <Setter Property="Background" Value="{StaticResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandSoft}" />
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandSoftHover}" />
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Anim.PressDown}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Anim.PressUp}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 列表项（文件夹、版本、设置分页）：Tag = 图标几何，Content = 标题，ToolTip 之外的说明放在 DataContext 中 -->
  <Style x:Key="Fcp.ListItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="6,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" />
            <Border x:Name="Accent" Width="3" Height="16" HorizontalAlignment="Left" CornerRadius="1.5" Background="{StaticResource Brush.Brand}" Opacity="0" />
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Path x:Name="IconPath" Data="{TemplateBinding Tag}" Style="{StaticResource Fcp.Icon}" Fill="{StaticResource Brush.TextSecondary}" Margin="0,0,10,0" VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
              <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandSoft}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandSoft}" />
              <Setter TargetName="Accent" Property="Opacity" Value="1" />
              <Setter TargetName="IconPath" Property="Fill" Value="{StaticResource Brush.Brand}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 可点击的卡片行（版本卡片中的条目） -->
  <Style x:Key="Fcp.RowButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandSoft}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandSoftHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 搜索框 -->
  <Style x:Key="Fcp.SearchBox" TargetType="TextBox">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bg" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="17" Padding="12,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Path Data="{StaticResource Icon.Search}" Style="{StaticResource Fcp.Icon}" Width="14" Height="14" Fill="{StaticResource Brush.TextTertiary}" Margin="0,0,8,0" />
              <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
              <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 进度条 -->
  <Style x:Key="Fcp.ProgressBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
    <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
