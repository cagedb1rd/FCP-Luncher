<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:FCP.UI.Controls">
  <!-- 显式合并依赖的字典：模板中的 StaticResource 只能可靠地解析到本字典及其合并字典中的资源 -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/FCP.UI;component/Themes/Tokens.Light.xaml" />
    <ResourceDictionary Source="pack://application:,,,/FCP.UI;component/Themes/Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ================= 动画 ================= -->
  <!-- 按下时轻微缩放（0.97），松开时回弹；要求 RenderTransform 为 ScaleTransform -->
  <Storyboard x:Key="Anim.PressDown">
    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.08" />
    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.08" />
  </Storyboard>
  <Storyboard x:Key="Anim.PressUp">
    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2">
      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
    </DoubleAnimation>
    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2">
      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
    </DoubleAnimation>
  </Storyboard>
  <!-- 悬停时浮起 3px；要求 RenderTransform 为 TranslateTransform -->
  <Storyboard x:Key="Anim.LiftUp">
    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="-3" Duration="0:0:0.18">
      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
    </DoubleAnimation>
  </Storyboard>
  <Storyboard x:Key="Anim.LiftDown">
    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.2">
      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
    </DoubleAnimation>
  </Storyboard>

  <!-- ================= 基础 ================= -->
  <Style x:Key="Fcp.Icon" TargetType="Path">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    <Setter Property="SnapsToDevicePixels" Value="False" />
  </Style>

  <Style x:Key="Fcp.Text.Display" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
  </Style>
  <Style x:Key="Fcp.Text.CardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
  </Style>
  <Style x:Key="Fcp.Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
  </Style>
  <Style x:Key="Fcp.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Fcp.Text.Caption}">
    <Setter Property="Margin" Value="16,16,8,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 卡片：半透明玻璃 + 顶部高光描边 + 柔和阴影 -->
  <Style x:Key="Fcp.Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.CardHighlight}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Effect" Value="{StaticResource Shadow.Card}" />
  </Style>

  <!-- 小图标底块（卡片标题前的彩色方块），Background 由使用处指定 -->
  <Style x:Key="Fcp.IconTile" TargetType="Border">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
  </Style>

  <!-- 彩色标签 -->
  <Style TargetType="ui:Chip">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
    <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
    <Setter Property="Padding" Value="8,2,8,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:Chip">
          <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tone" Value="Amber">
        <Setter Property="Foreground" Value="#B26B00" />
        <Setter Property="Background" Value="{StaticResource Brush.AmberSoft}" />
      </Trigger>
      <Trigger Property="Tone" Value="Sky">
        <Setter Property="Foreground" Value="#0372A6" />
        <Setter Property="Background" Value="{StaticResource Brush.SkySoft}" />
      </Trigger>
      <Trigger Property="Tone" Value="Purple">
        <Setter Property="Foreground" Value="#6D3FD9" />
        <Setter Property="Background" Value="{StaticResource Brush.PurpleSoft}" />
      </Trigger>
      <Trigger Property="Tone" Value="Rose">
        <Setter Property="Foreground" Value="#C81E43" />
        <Setter Property="Background" Value="{StaticResource Brush.RoseSoft}" />
      </Trigger>
      <Trigger Property="Tone" Value="Gray">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="{StaticResource Brush.GraySoft}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 提示框 -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="#E61A2A22" CornerRadius="6" Padding="9,5" Margin="6">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= 标题栏 ================= -->
  <Style x:Key="Fcp.WindowButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnBrand}" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="16">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.OnBrandHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.OnBrandPressed}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 主标签：图标 + 文字；选中时为带阴影的白色胶囊 -->
  <Style x:Key="Fcp.TabButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnBrand}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Margin" Value="3,0" />
    <Setter Property="Padding" Value="13,0,15,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="15" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Data="{TemplateBinding Tag}" Style="{StaticResource Fcp.Icon}" Width="15" Height="15" Margin="0,0,7,0" Fill="{TemplateBinding Foreground}" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.OnBrandHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.OnBrand}" />
              <Setter TargetName="Bg" Property="Effect" Value="{StaticResource Shadow.Pill}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.BrandDeep}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Anim.PressDown}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Anim.PressUp}" /></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= 按钮 ================= -->
  <!-- 启动游戏大按钮：Content = 主文字，Tag = 副标题（版本名）；渐变 + 光晕 + 悬停扫光 -->
  <Style x:Key="Fcp.LaunchButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnBrand}" />
    <Setter Property="Height" Value="64" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bg" CornerRadius="12" Background="{StaticResource Brush.BrandGradient}" Effect="{StaticResource Shadow.BrandGlow}" />
            <Rectangle x:Name="Shine" RadiusX="12" RadiusY="12" IsHitTestVisible="False">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.4">
                  <LinearGradientBrush.RelativeTransform><TranslateTransform X="-1.2" /></LinearGradientBrush.RelativeTransform>
                  <GradientStop Color="#00FFFFFF" Offset="0.3" />
                  <GradientStop Color="#55FFFFFF" Offset="0.5" />
                  <GradientStop Color="#00FFFFFF" Offset="0.7" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Border CornerRadius="12" BorderThickness="1" BorderBrush="#40FFFFFF" IsHitTestVisible="False" />
            <Grid Margin="14,0,16,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border Width="38" Height="38" CornerRadius="10" Background="#33FFFFFF">
                <Path Data="{StaticResource Icon.Play}" Style="{StaticResource Fcp.Icon}" Width="18" Height="18" Fill="White" Margin="2,0,0,0" />
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <ContentPresenter TextElement.FontSize="19" TextElement.FontWeight="Bold" />
                <TextBlock Text="{TemplateBinding Tag}" FontSize="{StaticResource FontSize.Caption}" Opacity="0.88" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="(Shape.Fill).(Brush.RelativeTransform).(TranslateTransform.X)"
                                   From="-1.2" To="1.2" Duration="0:0:0.9">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandGradientHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Anim.PressDown}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Anim.PressUp}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 次级按钮：玻璃底 + 品牌色文字；Tag 可放图标几何 -->
  <Style x:Key="Fcp.Button" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.BrandDeep}" />
    <Setter Property="Background" Value="{StaticResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}" Effect="{StaticResource Shadow.Card}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path x:Name="IconPath" Data="{TemplateBinding Tag}" Style="{StaticResource Fcp.Icon}" Width="15" Height="15" Margin="0,0,7,0" Fill="{TemplateBinding Foreground}" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
              <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandSoft}" />
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandSoftHover}" />
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Anim.PressDown}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Anim.PressUp}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 卡片式按钮（主页的游玩卡片等）：悬停时浮起并加深阴影 -->
  <Style x:Key="Fcp.CardButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="RenderTransform"><Setter.Value><TranslateTransform /></Setter.Value></Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Card" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardHighlight}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Card}" Padding="{TemplateBinding Padding}" Effect="{StaticResource Shadow.Card}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Card" Property="Background" Value="{StaticResource Brush.CardSolid}" />
              <Setter TargetName="Card" Property="Effect" Value="{StaticResource Shadow.CardHover}" />
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Anim.LiftUp}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Anim.LiftDown}" /></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 列表中的可点击行 -->
  <Style x:Key="Fcp.RowButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandSoft}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandSoftHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 左侧列表项（文件夹、设置分页）：Tag = 图标几何 -->
  <Style x:Key="Fcp.ListItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Margin" Value="8,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" />
            <Border x:Name="Accent" Width="4" Height="18" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Brush.BrandGradient}" Opacity="0" />
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Path x:Name="IconPath" Data="{TemplateBinding Tag}" Style="{StaticResource Fcp.Icon}" Fill="{StaticResource Brush.TextSecondary}" Margin="0,0,11,0" VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
              <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#80FFFFFF" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.CardSolid}" />
              <Setter TargetName="Bg" Property="Effect" Value="{StaticResource Shadow.Card}" />
              <Setter TargetName="Accent" Property="Opacity" Value="1" />
              <Setter TargetName="IconPath" Property="Fill" Value="{StaticResource Brush.Brand}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.BrandDeep}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= 表单控件（隐式样式） ================= -->
  <!-- 单选按钮 -->
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="18" Height="18" VerticalAlignment="Center">
              <Ellipse x:Name="Ring" Stroke="{StaticResource Brush.Border}" StrokeThickness="1.6" Fill="White" />
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Brush.Brand}" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0" /></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Brand}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Brand}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 开关（CheckBox） -->
  <Style x:Key="Fcp.Toggle" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="40" Height="22" VerticalAlignment="Center">
              <Border x:Name="Track" CornerRadius="11" Background="#D5DED9" />
              <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0" Effect="{StaticResource Shadow.Pill}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.BrandGradient}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.X" To="18" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 滑块 -->
  <Style x:Key="Fcp.SliderFill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Height="6" CornerRadius="3" Background="{StaticResource Brush.BrandGradient}" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Fcp.SliderEmpty" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Rectangle Fill="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="Height" Value="24" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid>
            <Border Height="6" CornerRadius="3" Background="#DCE5E0" VerticalAlignment="Center" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Fcp.SliderFill}" Command="Slider.DecreaseLarge" /></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Fcp.SliderEmpty}" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" Stroke="{StaticResource Brush.Brand}" StrokeThickness="3" Effect="{StaticResource Shadow.Pill}" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Knob" Property="StrokeThickness" Value="4" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 细滚动条 -->
  <Style x:Key="Fcp.ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Rectangle Fill="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Fcp.ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" CornerRadius="3" Background="#2E16231C" Margin="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="#5516231C" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="#7716231C" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Fcp.ScrollPage}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Fcp.ScrollPage}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource Fcp.ScrollThumb}" /></Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Fcp.ScrollPage}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Fcp.ScrollPage}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource Fcp.ScrollThumb}" /></Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 搜索框：Tag = 占位文字 -->
  <Style x:Key="Fcp.SearchBox" TargetType="TextBox">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="Height" Value="38" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bg" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardHighlight}" BorderThickness="1"
                  CornerRadius="19" Padding="14,0" Effect="{StaticResource Shadow.Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Path Data="{StaticResource Icon.Search}" Style="{StaticResource Fcp.Icon}" Width="15" Height="15" Fill="{StaticResource Brush.TextTertiary}" Margin="0,0,9,0" />
              <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
              <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.CardSolid}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 进度条 -->
  <Style x:Key="Fcp.ProgressBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" Background="{StaticResource Brush.BrandSoft}" CornerRadius="3" />
            <Border x:Name="PART_Indicator" Background="{StaticResource Brush.BrandGradient}" CornerRadius="3" HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
