<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- 设计令牌（浅色主题）。默认品牌色为翠绿 → 青绿，与 PCL 的蓝色区分（docs/decisions.md D-013）。 -->

  <!-- 品牌色 -->
  <Color x:Key="Color.Brand">#16A34A</Color>
  <Color x:Key="Color.BrandHover">#1DB857</Color>
  <Color x:Key="Color.BrandPressed">#11843C</Color>
  <Color x:Key="Color.BrandDeep">#0E7A52</Color>
  <Color x:Key="Color.BrandTeal">#14B8A6</Color>
  <Color x:Key="Color.BrandSoft">#DCF5E6</Color>
  <Color x:Key="Color.BrandSoftHover">#C8EED8</Color>
  <Color x:Key="Color.TitleStart">#0F8A4E</Color>
  <Color x:Key="Color.TitleMid">#16A34A</Color>
  <Color x:Key="Color.TitleEnd">#0FA39A</Color>

  <!-- 辅助色（标签、图标底色） -->
  <Color x:Key="Color.Amber">#F59E0B</Color>
  <Color x:Key="Color.AmberSoft">#FEF1D6</Color>
  <Color x:Key="Color.Sky">#0EA5E9</Color>
  <Color x:Key="Color.SkySoft">#DDF2FC</Color>
  <Color x:Key="Color.Purple">#8B5CF6</Color>
  <Color x:Key="Color.PurpleSoft">#EDE6FE</Color>
  <Color x:Key="Color.Rose">#F43F5E</Color>
  <Color x:Key="Color.RoseSoft">#FDE2E7</Color>
  <Color x:Key="Color.GraySoft">#EDF1EF</Color>

  <!-- 中性色 -->
  <Color x:Key="Color.WindowTop">#E3F6EC</Color>
  <Color x:Key="Color.WindowMid">#EEF7F4</Color>
  <Color x:Key="Color.WindowBottom">#E6F2FA</Color>
  <Color x:Key="Color.Sidebar">#99FFFFFF</Color>
  <Color x:Key="Color.Card">#D9FFFFFF</Color>
  <Color x:Key="Color.CardSolid">#FFFFFFFF</Color>
  <Color x:Key="Color.CardEdge">#B3FFFFFF</Color>
  <Color x:Key="Color.Border">#DCE6E1</Color>
  <Color x:Key="Color.TextPrimary">#16231C</Color>
  <Color x:Key="Color.TextSecondary">#536459</Color>
  <Color x:Key="Color.TextTertiary">#87978E</Color>
  <Color x:Key="Color.OnBrand">#FFFFFF</Color>

  <!-- 状态色 -->
  <Color x:Key="Color.Success">#16A34A</Color>
  <Color x:Key="Color.Info">#0EA5E9</Color>
  <Color x:Key="Color.Warning">#F59E0B</Color>
  <Color x:Key="Color.Danger">#E5484D</Color>

  <SolidColorBrush x:Key="Brush.Brand" Color="{StaticResource Color.Brand}" />
  <SolidColorBrush x:Key="Brush.BrandHover" Color="{StaticResource Color.BrandHover}" />
  <SolidColorBrush x:Key="Brush.BrandPressed" Color="{StaticResource Color.BrandPressed}" />
  <SolidColorBrush x:Key="Brush.BrandDeep" Color="{StaticResource Color.BrandDeep}" />
  <SolidColorBrush x:Key="Brush.BrandSoft" Color="{StaticResource Color.BrandSoft}" />
  <SolidColorBrush x:Key="Brush.BrandSoftHover" Color="{StaticResource Color.BrandSoftHover}" />
  <SolidColorBrush x:Key="Brush.Amber" Color="{StaticResource Color.Amber}" />
  <SolidColorBrush x:Key="Brush.AmberSoft" Color="{StaticResource Color.AmberSoft}" />
  <SolidColorBrush x:Key="Brush.Sky" Color="{StaticResource Color.Sky}" />
  <SolidColorBrush x:Key="Brush.SkySoft" Color="{StaticResource Color.SkySoft}" />
  <SolidColorBrush x:Key="Brush.Purple" Color="{StaticResource Color.Purple}" />
  <SolidColorBrush x:Key="Brush.PurpleSoft" Color="{StaticResource Color.PurpleSoft}" />
  <SolidColorBrush x:Key="Brush.Rose" Color="{StaticResource Color.Rose}" />
  <SolidColorBrush x:Key="Brush.RoseSoft" Color="{StaticResource Color.RoseSoft}" />
  <SolidColorBrush x:Key="Brush.GraySoft" Color="{StaticResource Color.GraySoft}" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
  <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
  <SolidColorBrush x:Key="Brush.CardSolid" Color="{StaticResource Color.CardSolid}" />
  <SolidColorBrush x:Key="Brush.CardEdge" Color="{StaticResource Color.CardEdge}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
  <SolidColorBrush x:Key="Brush.OnBrand" Color="{StaticResource Color.OnBrand}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.OnBrandHover" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="Brush.OnBrandPressed" Color="#40FFFFFF" />

  <LinearGradientBrush x:Key="Brush.TitleBar" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{StaticResource Color.TitleStart}" Offset="0" />
    <GradientStop Color="{StaticResource Color.TitleMid}" Offset="0.5" />
    <GradientStop Color="{StaticResource Color.TitleEnd}" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.BrandGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#1DB857" Offset="0" />
    <GradientStop Color="#0FA39A" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.BrandGradientHover" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#25C962" Offset="0" />
    <GradientStop Color="#13B5AB" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.WindowBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource Color.WindowTop}" Offset="0" />
    <GradientStop Color="{StaticResource Color.WindowMid}" Offset="0.5" />
    <GradientStop Color="{StaticResource Color.WindowBottom}" Offset="1" />
  </LinearGradientBrush>
  <!-- 玻璃卡片的顶部高光描边 -->
  <LinearGradientBrush x:Key="Brush.CardHighlight" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFFFF" Offset="0" />
    <GradientStop Color="#33FFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- 字体与尺寸 -->
  <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
  <sys:Double x:Key="FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="FontSize.Body">13</sys:Double>
  <sys:Double x:Key="FontSize.Subtitle">14</sys:Double>
  <sys:Double x:Key="FontSize.Title">16</sys:Double>
  <sys:Double x:Key="FontSize.Hero">20</sys:Double>
  <sys:Double x:Key="FontSize.Display">26</sys:Double>
  <CornerRadius x:Key="Radius.Card">10</CornerRadius>
  <CornerRadius x:Key="Radius.Control">8</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">14</CornerRadius>

  <DropShadowEffect x:Key="Shadow.Card" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.07" Color="#0E3B24" />
  <DropShadowEffect x:Key="Shadow.CardHover" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.13" Color="#0E3B24" />
  <DropShadowEffect x:Key="Shadow.Elevated" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.16" Color="#0E3B24" />
  <DropShadowEffect x:Key="Shadow.BrandGlow" BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.35" Color="#16A34A" />
  <DropShadowEffect x:Key="Shadow.Pill" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.18" Color="#0E3B24" />
</ResourceDictionary>
