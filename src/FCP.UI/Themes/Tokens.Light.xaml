<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- 设计令牌（浅色主题）。默认品牌色为草绿色，与 PCL 的蓝色区分（docs/decisions.md D-013）。 -->

  <!-- 品牌色 -->
  <Color x:Key="Color.Brand">#1E9E5A</Color>
  <Color x:Key="Color.BrandHover">#23B066</Color>
  <Color x:Key="Color.BrandPressed">#16824A</Color>
  <Color x:Key="Color.BrandSoft">#E3F4EA</Color>
  <Color x:Key="Color.BrandSoftHover">#D2EDDD</Color>
  <Color x:Key="Color.TitleStart">#178B52</Color>
  <Color x:Key="Color.TitleEnd">#2AAE6E</Color>

  <!-- 中性色 -->
  <Color x:Key="Color.WindowTop">#EAF5EF</Color>
  <Color x:Key="Color.WindowBottom">#F4F6F5</Color>
  <Color x:Key="Color.Sidebar">#B3FFFFFF</Color>
  <Color x:Key="Color.Card">#F2FFFFFF</Color>
  <Color x:Key="Color.CardHover">#FFFFFFFF</Color>
  <Color x:Key="Color.Border">#E0E7E3</Color>
  <Color x:Key="Color.TextPrimary">#1E2A23</Color>
  <Color x:Key="Color.TextSecondary">#5A6A61</Color>
  <Color x:Key="Color.TextTertiary">#8C9A92</Color>
  <Color x:Key="Color.OnBrand">#FFFFFF</Color>

  <!-- 状态色 -->
  <Color x:Key="Color.Success">#1E9E5A</Color>
  <Color x:Key="Color.Info">#2F7DD1</Color>
  <Color x:Key="Color.Warning">#D99A1E</Color>
  <Color x:Key="Color.Danger">#D64545</Color>

  <SolidColorBrush x:Key="Brush.Brand" Color="{StaticResource Color.Brand}" />
  <SolidColorBrush x:Key="Brush.BrandHover" Color="{StaticResource Color.BrandHover}" />
  <SolidColorBrush x:Key="Brush.BrandPressed" Color="{StaticResource Color.BrandPressed}" />
  <SolidColorBrush x:Key="Brush.BrandSoft" Color="{StaticResource Color.BrandSoft}" />
  <SolidColorBrush x:Key="Brush.BrandSoftHover" Color="{StaticResource Color.BrandSoftHover}" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
  <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
  <SolidColorBrush x:Key="Brush.CardHover" Color="{StaticResource Color.CardHover}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
  <SolidColorBrush x:Key="Brush.OnBrand" Color="{StaticResource Color.OnBrand}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.OnBrandHover" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="Brush.OnBrandPressed" Color="#40FFFFFF" />

  <LinearGradientBrush x:Key="Brush.TitleBar" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{StaticResource Color.TitleStart}" Offset="0" />
    <GradientStop Color="{StaticResource Color.TitleEnd}" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.WindowBackground" StartPoint="0.9,0" EndPoint="0.1,1">
    <GradientStop Color="{StaticResource Color.WindowTop}" Offset="0" />
    <GradientStop Color="{StaticResource Color.WindowBottom}" Offset="1" />
  </LinearGradientBrush>

  <!-- 字体与尺寸 -->
  <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
  <sys:Double x:Key="FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="FontSize.Body">13</sys:Double>
  <sys:Double x:Key="FontSize.Subtitle">14</sys:Double>
  <sys:Double x:Key="FontSize.Title">16</sys:Double>
  <sys:Double x:Key="FontSize.Hero">20</sys:Double>
  <CornerRadius x:Key="Radius.Card">8</CornerRadius>
  <CornerRadius x:Key="Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">14</CornerRadius>

  <DropShadowEffect x:Key="Shadow.Card" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#1E2A23" />
  <DropShadowEffect x:Key="Shadow.Elevated" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.14" Color="#1E2A23" />
</ResourceDictionary>
