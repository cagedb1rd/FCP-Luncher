<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:FCP.UI.Converters">
  <!-- 应用只需要合并这一个字典 -->
  <ResourceDictionary.MergedDictionaries>
    <!-- Controls.xaml 内部已合并 Tokens 与 Icons -->
    <ResourceDictionary Source="pack://application:,,,/FCP.UI;component/Themes/Controls.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <conv:EnumEqualsConverter x:Key="EnumEquals" />
  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:ResourceKeyConverter x:Key="ResourceKey" />
  <conv:RatioToStarConverter x:Key="RatioToStar" />
  <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
</ResourceDictionary>
