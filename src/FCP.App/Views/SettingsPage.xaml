<UserControl x:Class="FCP.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FCP.UI.Controls;assembly=FCP.UI"
             xmlns:vm="clr-namespace:FCP.App.ViewModels">
  <UserControl.Resources>
    <!-- “游戏启动后”的选项卡片 -->
    <Style x:Key="OptionCard" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" CornerRadius="10" BorderThickness="1.5" BorderBrush="{StaticResource Brush.Border}" Background="#B3FFFFFF" Padding="12,10" Margin="0,0,8,0">
              <StackPanel>
                <Path x:Name="IconPath" Data="{TemplateBinding Tag}" Style="{StaticResource Fcp.Icon}" Width="18" Height="18" HorizontalAlignment="Left" Fill="{StaticResource Brush.TextSecondary}" />
                <ContentPresenter Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.BrandSoftHover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.BrandSoft}" />
                <Setter TargetName="IconPath" Property="Fill" Value="{StaticResource Brush.Brand}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>

    <!-- 左侧分页：启动 / 个性化 / 下载 / 其他 -->
    <Border Background="{StaticResource Brush.Sidebar}" BorderBrush="#80FFFFFF" BorderThickness="0,0,1,0">
      <StackPanel Margin="0,12,0,0">
        <RadioButton Style="{StaticResource Fcp.ListItem}" Content="启动" Tag="{StaticResource Icon.Play}"
                     IsChecked="{Binding Section, Converter={StaticResource EnumEquals}, ConverterParameter=Launch}" />
        <RadioButton Style="{StaticResource Fcp.ListItem}" Content="个性化" Tag="{StaticResource Icon.PaintBrush}"
                     IsChecked="{Binding Section, Converter={StaticResource EnumEquals}, ConverterParameter=Personalization}" />
        <RadioButton Style="{StaticResource Fcp.ListItem}" Content="下载" Tag="{StaticResource Icon.Download}"
                     IsChecked="{Binding Section, Converter={StaticResource EnumEquals}, ConverterParameter=Download}" />
        <RadioButton Style="{StaticResource Fcp.ListItem}" Content="其他" Tag="{StaticResource Icon.Wrench}"
                     IsChecked="{Binding Section, Converter={StaticResource EnumEquals}, ConverterParameter=Other}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22,18,22,22">
        <!-- 启动选项 -->
        <Border Style="{StaticResource Fcp.Card}" ui:Motion.Entrance="True">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Fcp.IconTile}">
                <Path Data="{StaticResource Icon.Play}" Style="{StaticResource Fcp.Icon}" Fill="{StaticResource Brush.Brand}" />
              </Border>
              <TextBlock Text="启动选项" Style="{StaticResource Fcp.Text.CardTitle}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <Grid Margin="2,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="为安装了 Mod 的版本开启版本隔离" />
                <TextBlock Text="存档、Mod 和设置与其他版本互不影响，避免 Mod 冲突" Style="{StaticResource Fcp.Text.Caption}" Margin="0,3,0,0" />
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource Fcp.Toggle}" IsChecked="{Binding IsolateModdedByDefault}" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="2,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="自动把游戏语言设为简体中文" />
                <TextBlock Text="仅在第一次启动某个版本时设置，之后不会再改动" Style="{StaticResource Fcp.Text.Caption}" Margin="0,3,0,0" />
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource Fcp.Toggle}" IsChecked="{Binding AutoChineseLanguage}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="游戏启动后，启动器" Margin="2,16,0,8" />
            <UniformGrid Columns="3">
              <RadioButton Style="{StaticResource OptionCard}" Tag="{StaticResource Icon.Window}" GroupName="Visibility"
                           IsChecked="{Binding Visibility, Converter={StaticResource EnumEquals}, ConverterParameter=KeepOpen}">
                <StackPanel>
                  <TextBlock Text="保持不变" FontWeight="SemiBold" />
                  <TextBlock Text="方便同时操作" Style="{StaticResource Fcp.Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource OptionCard}" Tag="{StaticResource Icon.Subtract}" GroupName="Visibility"
                           IsChecked="{Binding Visibility, Converter={StaticResource EnumEquals}, ConverterParameter=Minimize}">
                <StackPanel>
                  <TextBlock Text="最小化" FontWeight="SemiBold" />
                  <TextBlock Text="留在任务栏" Style="{StaticResource Fcp.Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource OptionCard}" Tag="{StaticResource Icon.Sparkle}" GroupName="Visibility"
                           IsChecked="{Binding Visibility, Converter={StaticResource EnumEquals}, ConverterParameter=HideAndRestore}">
                <StackPanel>
                  <TextBlock Text="隐藏" FontWeight="SemiBold" />
                  <TextBlock Text="游戏退出后自动回来" Style="{StaticResource Fcp.Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
              </RadioButton>
            </UniformGrid>
          </StackPanel>
        </Border>

        <!-- 内存分配 -->
        <Border Style="{StaticResource Fcp.Card}" Margin="0,14,0,0" ui:Motion.Entrance="True" ui:Motion.Delay="70">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Fcp.IconTile}" Background="{StaticResource Brush.SkySoft}">
                <Path Data="{StaticResource Icon.Memory}" Style="{StaticResource Fcp.Icon}" Fill="{StaticResource Brush.Sky}" />
              </Border>
              <TextBlock Text="内存分配" Style="{StaticResource Fcp.Text.CardTitle}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
              <RadioButton Content="自动配置（推荐）" IsChecked="{Binding IsMemoryAuto}" Margin="0,0,26,0" />
              <RadioButton Content="自定义" IsChecked="{Binding IsMemoryCustom}" />
            </StackPanel>
            <Grid Margin="2,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="80" />
              </Grid.ColumnDefinitions>
              <Slider Minimum="1" Maximum="24" Value="{Binding MemoryGb}" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding MemoryGb, StringFormat={}{0:0.#} GB}" HorizontalAlignment="Right" VerticalAlignment="Center"
                         FontSize="{StaticResource FontSize.Hero}" FontWeight="Bold" Foreground="{StaticResource Brush.BrandDeep}" />
            </Grid>
            <!-- 比例条：已使用 / 游戏分配 / 剩余 -->
            <Grid Height="10" Margin="2,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding MemoryUsedRatio, Converter={StaticResource RatioToStar}}" />
                <ColumnDefinition Width="{Binding MemoryGameRatio, Converter={StaticResource RatioToStar}}" />
                <ColumnDefinition Width="{Binding MemoryFreeRatio, Converter={StaticResource RatioToStar}}" />
              </Grid.ColumnDefinitions>
              <Border Background="#9AA8A0" CornerRadius="5,0,0,5" Margin="0,0,2,0" />
              <Border Grid.Column="1" Background="{StaticResource Brush.BrandGradient}" Margin="0,0,2,0" />
              <Border Grid.Column="2" Background="#DCE5E0" CornerRadius="0,5,5,0" />
            </Grid>
            <WrapPanel Margin="2,10,0,0">
              <Ellipse Width="8" Height="8" Fill="#9AA8A0" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource Fcp.Text.Caption}" Margin="6,0,16,0"><Run Text="已使用 " /><Run Text="{Binding UsedMemoryGb, Mode=OneWay, StringFormat={}{0:0.#} GB}" /></TextBlock>
              <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Brand}" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource Fcp.Text.Caption}" Margin="6,0,16,0"><Run Text="游戏分配 " /><Run Text="{Binding MemoryGb, Mode=OneWay, StringFormat={}{0:0.#} GB}" /></TextBlock>
              <Ellipse Width="8" Height="8" Fill="#DCE5E0" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource Fcp.Text.Caption}" Margin="6,0,0,0"><Run Text="剩余 " /><Run Text="{Binding MemoryFreeGb, Mode=OneWay, StringFormat={}{0:0.#} GB}" /></TextBlock>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Java 管理 -->
        <Border Style="{StaticResource Fcp.Card}" Margin="0,14,0,0" ui:Motion.Entrance="True" ui:Motion.Delay="140">
          <StackPanel>
            <Grid>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Fcp.IconTile}" Background="{StaticResource Brush.PurpleSoft}">
                  <Path Data="{StaticResource Icon.Shield}" Style="{StaticResource Fcp.Icon}" Fill="{StaticResource Brush.Purple}" />
                </Border>
                <TextBlock Text="Java 管理" Style="{StaticResource Fcp.Text.CardTitle}" VerticalAlignment="Center" Margin="10,0,0,0" />
              </StackPanel>
              <Button Style="{StaticResource Fcp.Button}" Content="重新扫描" Tag="{StaticResource Icon.ArrowSync}" HorizontalAlignment="Right" Height="32" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Javas}" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:JavaEntry}">
                  <Border CornerRadius="8" Padding="10,8" Margin="0,3" Background="#80FFFFFF">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Version}" FontWeight="Bold" />
                          <TextBlock Text="{Binding Vendor}" Foreground="{StaticResource Brush.TextSecondary}" Margin="8,0,0,0" />
                          <ui:Chip x:Name="Recommended" Content="推荐" Tone="Brand" Margin="8,0,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Fcp.Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                      </StackPanel>
                      <ui:Chip Grid.Column="1" Content="{Binding Source}" Tone="Gray" />
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                      <Setter TargetName="Recommended" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
