<UserControl x:Class="FCP.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FCP.App.ViewModels">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="170" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>

    <!-- 左侧分页：启动 / 个性化 / 下载 / 其他 -->
    <Border Background="{StaticResource Brush.Sidebar}">
      <StackPanel Margin="0,10,0,0">
        <RadioButton Style="{StaticResource Fcp.ListItem}" Content="启动" Tag="{StaticResource Icon.Play}"
                     IsChecked="{Binding Section, Converter={StaticResource EnumEquals}, ConverterParameter=Launch}" />
        <RadioButton Style="{StaticResource Fcp.ListItem}" Content="个性化" Tag="{StaticResource Icon.Star}"
                     IsChecked="{Binding Section, Converter={StaticResource EnumEquals}, ConverterParameter=Personalization}" />
        <RadioButton Style="{StaticResource Fcp.ListItem}" Content="下载" Tag="{StaticResource Icon.Download}"
                     IsChecked="{Binding Section, Converter={StaticResource EnumEquals}, ConverterParameter=Download}" />
        <RadioButton Style="{StaticResource Fcp.ListItem}" Content="其他" Tag="{StaticResource Icon.Wrench}"
                     IsChecked="{Binding Section, Converter={StaticResource EnumEquals}, ConverterParameter=Other}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22,18,22,22">
        <!-- 启动：内存分配 -->
        <Border Style="{StaticResource Fcp.Card}">
          <StackPanel>
            <TextBlock Text="内存分配" Style="{StaticResource Fcp.Text.CardTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <RadioButton Content="自动配置" IsChecked="{Binding IsMemoryAuto}" Margin="0,0,24,0" VerticalContentAlignment="Center" />
              <RadioButton Content="自定义" IsChecked="{Binding IsMemoryCustom}" VerticalContentAlignment="Center" />
            </StackPanel>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="70" />
              </Grid.ColumnDefinitions>
              <Slider Minimum="1" Maximum="24" Value="{Binding MemoryGb}" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding MemoryGb, StringFormat={}{0:0.#} GB}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- 启动：Java 管理（独立卡片，显示来源） -->
        <Border Style="{StaticResource Fcp.Card}" Margin="0,14,0,0">
          <StackPanel>
            <Grid>
              <TextBlock Text="Java 管理" Style="{StaticResource Fcp.Text.CardTitle}" VerticalAlignment="Center" />
              <Button Style="{StaticResource Fcp.Button}" Content="重新扫描" HorizontalAlignment="Right" Height="30" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Javas}" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:JavaEntry}">
                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Path}" Style="{StaticResource Fcp.Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource Brush.BrandSoft}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Source}" FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource Brush.Brand}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
