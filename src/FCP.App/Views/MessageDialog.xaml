<UserControl x:Class="FCP.App.Views.MessageDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FCP.UI.Controls;assembly=FCP.UI"
             xmlns:vm="clr-namespace:FCP.App.ViewModels">
  <Border Width="520" Background="{StaticResource Brush.CardSolid}" CornerRadius="14" Padding="24,22,24,20"
          Effect="{StaticResource Shadow.Elevated}" ui:Motion.Entrance="True">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border>
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Fcp.IconTile}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                  <Setter Property="Background" Value="{StaticResource Brush.RoseSoft}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Path>
            <Path.Style>
              <Style TargetType="Path" BasedOn="{StaticResource Fcp.Icon}">
                <Setter Property="Data" Value="{StaticResource Icon.Info}" />
                <Setter Property="Fill" Value="{StaticResource Brush.Brand}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Path.Style>
          </Path>
        </Border>
        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource Brush.TextSecondary}" Margin="2,14,0,0" />

      <!-- 详细信息（日志末尾等）：可选择、可复制 -->
      <Border Background="{StaticResource Brush.GraySoft}" CornerRadius="8" Margin="0,14,0,0" Padding="2"
              Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 MaxHeight="260" Padding="8,6" VerticalScrollBarVisibility="Auto">
          <TextBox.Style>
            <Style TargetType="TextBox">
              <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
              <Setter Property="FontSize" Value="11.5" />
              <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
              <Setter Property="TextWrapping" Value="NoWrap" />
              <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DetailsMonospace}" Value="False">
                  <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
                  <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
                  <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
      </Border>

      <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right" Margin="0,18,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:DialogButton}">
            <Button x:Name="Btn" Style="{StaticResource Fcp.Button}" Content="{Binding Text}" MinWidth="96" Margin="8,0,0,0"
                    Command="{Binding DataContext.PressCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                <Setter TargetName="Btn" Property="Style" Value="{StaticResource Fcp.PrimaryButton}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
