<UserControl x:Class="FCP.App.Views.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FCP.App.ViewModels">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>

    <!-- ===== 左栏：账号 → 启动游戏 → 版本选择 / 版本设置（与 PCL 的位置和顺序一致） ===== -->
    <Border Background="{StaticResource Brush.Sidebar}">
      <Grid Margin="20,22,20,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 账号卡片 -->
        <Button Style="{StaticResource Fcp.RowButton}" Padding="0" Command="{Binding SwitchAccountCommand}" ToolTip="切换账号">
          <Border Style="{StaticResource Fcp.Card}" Padding="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="44" Height="44" CornerRadius="6" Background="{StaticResource Brush.BrandSoft}">
                <Path Data="{StaticResource Icon.Person}" Style="{StaticResource Fcp.Icon}" Width="22" Height="22" Fill="{StaticResource Brush.Brand}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding PlayerName}" Style="{StaticResource Fcp.Text.CardTitle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding AccountType}" Style="{StaticResource Fcp.Text.Caption}" Margin="0,3,0,0" />
              </StackPanel>
              <Path Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource Fcp.Icon}" Width="12" Height="12" Fill="{StaticResource Brush.TextTertiary}" />
            </Grid>
          </Border>
        </Button>

        <!-- 正常状态：启动按钮 + 次级按钮 -->
        <StackPanel Grid.Row="2" Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
          <Button Style="{StaticResource Fcp.LaunchButton}" Content="启动游戏" Tag="{Binding SelectedInstance.Name}"
                  Command="{Binding LaunchCommand}" ToolTip="启动游戏 (Ctrl+Enter)" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="10" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Fcp.Button}" Content="版本选择" Command="{Binding OpenInstanceSelectCommand}" />
            <Button Grid.Column="2" Style="{StaticResource Fcp.Button}" Content="版本设置" Command="{Binding OpenInstanceSettingsCommand}" />
          </Grid>
        </StackPanel>

        <!-- 启动中：进度面板 -->
        <StackPanel Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Center"
                    Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="正在启动游戏" HorizontalAlignment="Center" FontSize="{StaticResource FontSize.Hero}" Foreground="{StaticResource Brush.Brand}" />
          <TextBlock Text="{Binding SelectedInstance.Name}" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
          <ProgressBar Style="{StaticResource Fcp.ProgressBar}" Value="{Binding LaunchProgress, Mode=OneWay}" Maximum="100" Margin="10,18,10,14" />
          <Grid HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="当前步骤" Style="{StaticResource Fcp.Text.Caption}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Text="{Binding LaunchStage}" FontSize="{StaticResource FontSize.Caption}" />
            <TextBlock Grid.Row="1" Text="账号" Style="{StaticResource Fcp.Text.Caption}" HorizontalAlignment="Right" Margin="0,5,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PlayerName}" FontSize="{StaticResource FontSize.Caption}" Margin="0,5,0,0" />
            <TextBlock Grid.Row="2" Text="启动进度" Style="{StaticResource Fcp.Text.Caption}" HorizontalAlignment="Right" Margin="0,5,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LaunchProgress, StringFormat={}{0:0} %}" FontSize="{StaticResource FontSize.Caption}" Margin="0,5,0,0" />
          </Grid>
          <Button Style="{StaticResource Fcp.Button}" Content="取消" Command="{Binding CancelLaunchCommand}" Margin="40,24,40,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== 右栏：主页 ===== -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,22,24,24">
        <Border Style="{StaticResource Fcp.Card}">
          <StackPanel>
            <TextBlock Text="继续游玩" Style="{StaticResource Fcp.Text.CardTitle}" Margin="2,0,0,8" />
            <ItemsControl ItemsSource="{Binding Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:InstanceSummary}">
                  <Button Style="{StaticResource Fcp.RowButton}"
                          Command="{Binding DataContext.LaunchRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" ToolTip="直接启动">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource Brush.BrandSoft}">
                        <Path Data="{StaticResource Icon.Box}" Style="{StaticResource Fcp.Icon}" Fill="{StaticResource Brush.Brand}" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Fcp.Text.Caption}" Margin="0,2,0,0">
                          <Run Text="{Binding Info, Mode=OneWay}" /><Run Text=" · 上次 " /><Run Text="{Binding LastPlayed, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                      <Path Grid.Column="2" Data="{StaticResource Icon.Play}" Style="{StaticResource Fcp.Icon}" Fill="{StaticResource Brush.Brand}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Fcp.Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="已接管你在 PCL 中的游戏" Style="{StaticResource Fcp.Text.CardTitle}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}" LineHeight="20"
                       Text="找到 2 个游戏文件夹、2 个版本，版本设置已沿用。这两个版本使用 LittleSkin 登录，登录后选择原来的角色即可继续存档进度。（原型示例数据）" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
