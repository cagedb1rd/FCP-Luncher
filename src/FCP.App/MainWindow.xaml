<Window x:Class="FCP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FCP.UI.Controls;assembly=FCP.UI"
        xmlns:vm="clr-namespace:FCP.App.ViewModels"
        Title="FCP" Width="900" Height="560" MinWidth="810" MinHeight="470"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.WindowBackground}"
        FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource FontSize.Body}"
        Foreground="{StaticResource Brush.TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <!-- ===== 标题栏 ===== -->
    <Grid Background="{StaticResource Brush.TitleBar}">
      <!-- Logo（暂定） -->
      <StackPanel x:Name="Logo" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False">
        <Path Data="{StaticResource Icon.Box}" Style="{StaticResource Fcp.Icon}" Width="20" Height="20" Fill="White" />
        <TextBlock Text="FCP" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
      </StackPanel>

      <!-- 主标签：启动 / 下载 / 联机 / 设置 / 更多 -->
      <StackPanel x:Name="TabBar" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                  WindowChrome.IsHitTestVisibleInChrome="True">
        <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
        <RadioButton Style="{StaticResource Fcp.TabButton}" Content="启动" Tag="{StaticResource Icon.Play}"
                     IsChecked="{Binding SelectedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Launch}" />
        <RadioButton Style="{StaticResource Fcp.TabButton}" Content="下载" Tag="{StaticResource Icon.Download}"
                     Visibility="{Binding IsDownloadTabVisible, Converter={StaticResource BoolToVisibility}}"
                     IsChecked="{Binding SelectedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Download}" />
        <RadioButton Style="{StaticResource Fcp.TabButton}" Content="联机" Tag="{StaticResource Icon.People}"
                     Visibility="{Binding IsLinkTabVisible, Converter={StaticResource BoolToVisibility}}"
                     IsChecked="{Binding SelectedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Link}" />
        <RadioButton Style="{StaticResource Fcp.TabButton}" Content="设置" Tag="{StaticResource Icon.Settings}"
                     IsChecked="{Binding SelectedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}" />
        <RadioButton Style="{StaticResource Fcp.TabButton}" Content="更多" Tag="{StaticResource Icon.Grid}"
                     IsChecked="{Binding SelectedTab, Converter={StaticResource EnumEquals}, ConverterParameter=More}" />
      </StackPanel>

      <!-- 子页面标题：← 返回 + 标题 -->
      <StackPanel x:Name="SubHeader" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                  Opacity="0" IsHitTestVisible="False" WindowChrome.IsHitTestVisibleInChrome="True">
        <StackPanel.RenderTransform><TranslateTransform X="-16" /></StackPanel.RenderTransform>
        <Button Style="{StaticResource Fcp.WindowButton}" Command="{Binding BackCommand}" ToolTip="返回 (Esc)">
          <Path Data="{StaticResource Icon.ArrowLeft}" Style="{StaticResource Fcp.Icon}" Fill="White" />
        </Button>
        <TextBlock Text="{Binding SubPageTitle}" Foreground="White" FontSize="15" VerticalAlignment="Center" Margin="8,0,0,1" />
      </StackPanel>

      <!-- 窗口按钮 -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                  WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource Fcp.WindowButton}" Click="Minimize_Click" ToolTip="最小化">
          <Path Data="{StaticResource Icon.Subtract}" Style="{StaticResource Fcp.Icon}" Width="13" Height="13" Fill="White" />
        </Button>
        <Button Style="{StaticResource Fcp.WindowButton}" Click="Close_Click" ToolTip="关闭" Margin="4,0,0,0">
          <Path Data="{StaticResource Icon.Dismiss}" Style="{StaticResource Fcp.Icon}" Width="13" Height="13" Fill="White" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ===== 页面 ===== -->
    <ui:TransitionContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />

    <!-- ===== 提示条（左下角） ===== -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Hints}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                  Margin="0,0,0,18" IsHitTestVisible="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:HintItem}">
          <Border x:Name="Bar" Background="{StaticResource Brush.Info}" CornerRadius="0,16,16,0" Padding="16,7,18,7" Margin="0,4,0,0"
                  Effect="{StaticResource Shadow.Elevated}">
            <TextBlock Text="{Binding Text}" Foreground="White" FontSize="{StaticResource FontSize.Body}" />
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Success">
              <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error">
              <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.Danger}" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
