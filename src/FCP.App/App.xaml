<Application x:Class="FCP.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FCP.App.ViewModels"
             xmlns:views="clr-namespace:FCP.App.Views"
             xmlns:local="clr-namespace:FCP.App"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/FCP.UI;component/Themes/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <local:JavaSourceTextConverter x:Key="JavaSourceText" />
      <local:PathToImageConverter x:Key="PathToImage" />

      <!-- ViewModel → 页面 -->
      <DataTemplate DataType="{x:Type vm:LaunchPageViewModel}"><views:LaunchPage /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:InstanceSelectViewModel}"><views:InstanceSelectPage /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}"><views:SettingsPage /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}"><views:PlaceholderPage /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:InstanceSettingsViewModel}"><views:InstanceSettingsPage /></DataTemplate>
      <!-- ViewModel → 对话框 -->
      <DataTemplate DataType="{x:Type vm:MessageDialogViewModel}"><views:MessageDialog /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:AccountDialogViewModel}"><views:AccountDialog /></DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
